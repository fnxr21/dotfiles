{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Re-runs when the package list changes. packages-linux.txt hash: {{ include "packages-linux.txt" | sha256sum }}
set -euo pipefail

command -v apt-get >/dev/null || { echo "apt not found; install packages from packages-linux.txt by hand." >&2; exit 0; }
mapfile -t pkgs < <(grep -vE '^\s*(#|$)' {{ joinPath .chezmoi.sourceDir "packages-linux.txt" | quote }})
sudo apt-get update
sudo apt-get install -y "${pkgs[@]}"

# gitleaks is not in apt: download the release binary (checksum verified) to ~/.local/bin
GITLEAKS_VERSION=8.30.1
if ! command -v gitleaks >/dev/null; then
  case "$(uname -m)" in
    x86_64) arch=x64 ;; aarch64|arm64) arch=arm64 ;;
    *) echo "gitleaks: no release for $(uname -m); install it by hand" >&2; exit 0 ;;
  esac
  v=$GITLEAKS_VERSION tgz="gitleaks_${GITLEAKS_VERSION}_linux_${arch}.tar.gz"
  url="https://github.com/gitleaks/gitleaks/releases/download/v$v"
  tmp=$(mktemp -d)
  if curl -fsSL -o "$tmp/$tgz" "$url/$tgz" && curl -fsSL -o "$tmp/sums" "$url/gitleaks_${v}_checksums.txt" \
     && (cd "$tmp" && grep " $tgz\$" sums | sha256sum -c - >/dev/null) \
     && tar -xzf "$tmp/$tgz" -C "$tmp" gitleaks; then
    mkdir -p "$HOME/.local/bin" && install -m 755 "$tmp/gitleaks" "$HOME/.local/bin/gitleaks"
  else
    echo "gitleaks download or checksum failed; install it by hand" >&2
  fi
  rm -rf "$tmp"
fi
{{ end -}}
